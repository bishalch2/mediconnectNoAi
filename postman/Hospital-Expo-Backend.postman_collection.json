                ]
              }
            }
          ]
        },
        {
          "name": "Doctor Update Available Slot (optional; run after patient cancellation)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{updatedStartTime}}\",\n  \"endTime\": \"{{updatedEndTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/slots/slots/{{slotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "slots",
                "slots",
                "{{slotId}}"
              ]
            },
            "description": "Optional: run after Patient Cancel Booking. Moves the available 30-minute slot one day later without overlapping the original availability."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(new Date(pm.collectionVariables.get('startTime')).getTime() + 24 * 60 * 60 * 1000);",
                  "const end = new Date(start.getTime() + 30 * 60 * 1000);",
                  "pm.collectionVariables.set('updatedStartTime', start.toISOString());",
                  "pm.collectionVariables.set('updatedEndTime', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Available slot updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
