                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a patient account. Registration always starts with the patient role.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{patientName}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\",\n  \"idCardNumber\": \"{{patientIdCardNumber}}\"\n}",
              "options": {
                "raw": {
