{
  "info": {
    "name": "Hospital Expo Backend - Postman Tests",
    "description": "Test collection for the Express/Mongoose hospital management backend rebuilt from expo.docx. Seed the admin and start MongoDB/API first. Edit the collection variables before running. For duplicate-registration conflicts, use fresh emails/ID card values or reuse already-created accounts and log in directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
