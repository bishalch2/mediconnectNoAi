    {
      "name": "03 - Doctor Availability & Bookings",
      "item": [
        {
          "name": "Doctor Create Availability",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/slots/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "slots",
                "availability"
              ]
            },
            "description": "Creates a four-hour availability window with 10-minute slots (24 slots). Use a future date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"slotDurationMinutes\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 48 * 60 * 60 * 1000);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "start.setUTCHours(start.getUTCHours() + 1);",
                  "const end = new Date(start.getTime() + 4 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('startTime', start.toISOString());",
                  "pm.collectionVariables.set('endTime', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Availability created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Patient List Doctors",
          "request": {
            "method": "GET",
            "header": [
