PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_expo
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:8081
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Optional: the FastAPI app from the supplied document. Leave blank until its ML weights/config are installed.
PNEUMONIA_API_URL=http://127.0.0.1:8000/predict
# Used by npm run seed:admin. Set real values in your private .env file.
ADMIN_NAME=Hospital Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_ID_CARD_NUMBER=ADMIN-001
